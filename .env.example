# Frontend Environment Variables
# When running locally with backend on port 3000, leave blank (Vite proxy forwards /api and /ws)
# When deploying to Vercel (pointing to Render backend):
# VITE_API_BASE_URL="https://parlisense-be.onrender.com"
# VITE_WS_URL="wss://parlisense-be.onrender.com"
VITE_API_BASE_URL=""
VITE_WS_URL=""
# WebRTC connectivity. Add a TURN relay for clients on different/restrictive networks.
# This browser-visible configuration must never contain a TURN administrator secret.
VITE_RTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'

#Backend Environment Variables
# Database Configuration (Neon PostgreSQL)
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left empty, the server will fallback to local SQLite for lightweight development.
DATABASE_URL=""

# Backend server port
PORT=3000

# Allowed CORS origin for frontend (e.g. Vercel deployment URL or http://localhost:5173)
FRONTEND_URL="http://localhost:5173"

# Google Gemini API key
GEMINI_API_KEY=""

# Auth JWT Secret
JWT_SECRET="sansad-parlisense-auth-secret-key-2026"
